{
  "display_information": {
    "name": "claude-slack",
    "description": "Slack event bridge for Claude Code sessions."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "claude-slack",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "groups:history", "im:history", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups", "message.im"]
    },
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
