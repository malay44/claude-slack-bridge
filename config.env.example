# Copy to ~/.claude-slack/config.env and fill in.
# Folder of this repo (the bridge project).
CLAUDE_SLACK_BRIDGE_DIR="$HOME/claude-slack-bridge"
# Slack app ID (App Settings > Basic Information).
CLAUDE_SLACK_APP_ID="A0123456789"
# Your Slack user ID. Only messages from this user count as instructions.
CLAUDE_SLACK_OWNER="U0123456789"
# launchd label for the always-on bridge (macOS).
CLAUDE_SLACK_LABEL="com.claude-slack.bridge"
# Optional: where subscriptions live.
# CLAUDE_SLACK_SUBS_DIR="$HOME/.claude-slack/subs"
